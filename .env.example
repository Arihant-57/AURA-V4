# ==============================================================================
# AURA V4 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables to match your local setup.
# Never commit actual API keys, credentials, or personal secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Ollama Infrastructure (Default)
# ------------------------------------------------------------------------------
# Host URL for local Ollama instance (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Default models calibrated for 6GB VRAM (e.g. RTX 3050 Laptop GPU)
# qwen3.5:4b (~3.4GB) is prioritized for triage, analysis, and verification
# qwen2.5-coder:7b (~4.7GB) is prioritized for code generation and editing
AGENT_MODEL=qwen3.5:4b
AGENT_COMPLEX_MODEL=qwen2.5-coder:7b
AGENT_SYNTHESIS_MODEL=qwen3.5:4b

# Role-specific model overrides (optional; defaults fall back to the above)
AURA_LIGHTWEIGHT_MODEL=qwen3.5:4b
AURA_ANALYSIS_MODEL=qwen3.5:4b
AURA_CODING_MODEL=qwen2.5-coder:7b
AURA_VERIFICATION_MODEL=qwen3.5:4b

# ------------------------------------------------------------------------------
# 2. Inference & Generation Parameters
# ------------------------------------------------------------------------------
# Context window size in tokens (default: 12288)
AGENT_NUM_CTX=12288

# Generation sampling temperature (0.0 for deterministic outputs)
AGENT_TEMPERATURE=0.0

# Nucleus sampling probability
AGENT_TOP_P=0.1

# Maximum tokens generated in a single response/synthesis turn
AGENT_SYNTHESIS_MAX_TOKENS=1536

# Model call timeout in seconds (guards against hung inference streams)
AGENT_MODEL_TIMEOUT=120

# ------------------------------------------------------------------------------
# 3. Memory, Cache & Prefetch Settings
# ------------------------------------------------------------------------------
# Enable structural evidence pre-fetching (1 = enabled, 0 = disabled)
AGENT_PREFETCH=1

# Prefetch budget limits
AGENT_PREFETCH_MAX_READS=8
AGENT_PREFETCH_MANIFEST_CHARS=8000
AGENT_PREFETCH_SOURCE_RAW_CHARS=20000
AGENT_PREFETCH_SKELETON_CHARS=6000
AGENT_PREFETCH_PACKET_CHARS=28000
AGENT_EXECUTION_ORDER_BUDGET=5000

# Deterministic tool result cache time-to-live in seconds
AGENT_CACHE_TTL=300.0

# ------------------------------------------------------------------------------
# 4. Workspace & Security Settings
# ------------------------------------------------------------------------------
# Override target workspace path (defaults to current working directory)
# AURA_WORKSPACE=/path/to/target/project

# ------------------------------------------------------------------------------
# 5. Cloud Providers (Optional / Future Cloud Deployment)
# ------------------------------------------------------------------------------
# AURA V4 is 100% local-first by default with zero cloud dependency.
# Cloud endpoints are strictly optional for experimental testing.
FREELLMAPI_ENDPOINT=
FREELLMAPI_KEY=
